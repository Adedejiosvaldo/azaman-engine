# Copy to deploy/.env on the VPS and fill in. docker compose reads it automatically.

# Subdomain pointing at this VPS (A record -> VPS IP). Caddy gets the HTTPS certificate for it.
DOMAIN=api.example.com

# Optional: browser origins allowed to call the API (comma-separated), e.g. a separate frontend.
# Defaults to https://$DOMAIN (the built-in dashboard).
# ALLOWED_ORIGINS=https://api.example.com,https://app.example.com

# Optional: a long random string. Enables GET /api/v1/stats (audit and click counts, numbers only).
# Read them with: curl -H "Authorization: Bearer $STATS_TOKEN" https://$DOMAIN/api/v1/stats
# STATS_TOKEN=
