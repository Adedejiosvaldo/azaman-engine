# Caddy gets and renews the Let's Encrypt certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip

	# Engine caps bodies at 32MB; reject bigger uploads at the edge
	request_body {
		max_size 33MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# Don't log request bodies or query strings (statements, memos)
	log {
		output stdout
		format filter {
			request>uri query {
				replace * REDACTED
			}
		}
	}

	reverse_proxy azaman:8080 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}
}
